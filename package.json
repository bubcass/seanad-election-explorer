{
  "type": "module",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "clean": "rimraf src/.observablehq/cache",
    "build": "observable build",
    "dev": "observable preview",
    "deploy": "gh-pages -d dist",
    "build:election-normalised": "node src/data/transformers/normalize-election-2024.js",
    "build:election-final": "node src/data/transformers/build-final-rows.js",
    "build:election-data": "npm run build:election-normalised && npm run build:election-final",
    "observable": "observable",
    "security:audit": "npm audit --audit-level=critical",
    "security:runtime": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run build && npm run security:runtime"
  },
  "devDependencies": {
    "@observablehq/framework": "1.13.4",
    "d3": "7.9.0",
    "d3-dsv": "3.0.1",
    "gh-pages": "6.3.0",
    "leaflet": "1.9.4",
    "rimraf": "5.0.10"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
